---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { articles, topics } from '../lib/content';
import { site } from '../../site.config.mjs';
const all = await articles(); const ts = await topics();
---
<Base title={site.title} description={site.description}>
<section class="intro">
<p class="eyebrow">个人研究与实践 / 持续更新的知识库</p>
<h1>理解 AI，<br/>也理解它进入企业之后。</h1>
<div class="intro-bottom">
<p>我的工作位于 <strong>AI、企业经营与投资 / 资本</strong>的交叉处。这里记录我持续研究的问题、逐步形成的判断，以及实践中的方法与反思。</p>
<a class="text-link" href="/about/">关于我与工作背景 <span aria-hidden="true">↗</span>
</a>
</div>
</section>
<section class="section">
<div class="section-heading">
<h2>长期研究的问题</h2>
<a href="/topics/">全部主题 <span aria-hidden="true">→</span>
</a>
</div>
<div class="topic-grid">{ts.map((t,i) => <a class="topic-item" href={`/topics/${t.data.slug}/`}>
<span class="topic-index">{String(i+1).padStart(2,'0')}</span>
<div>
<h3>{t.data.title}</h3>
<p>{t.data.description}</p>
</div>
<span class="topic-count">{all.filter(a => a.data.topics.includes(t.data.slug)).length} 篇</span>
</a>)}</div>
</section>
<div class="home-columns">
<section class="section">
<div class="section-heading">
<h2>代表性研究</h2>
<a href="/research/">研究文章 →</a>
</div>
<ArticleList items={all.filter(a => a.data.type === 'research' && a.data.featured).slice(0,3)}/>
</section>
<section class="section">
<div class="section-heading">
<h2>最近更新</h2>
<a href="/archive/">归档 →</a>
</div>
<ArticleList items={all.slice(0,5)} compact/>
</section>
</div>
<section class="closing">
<div>
<p class="eyebrow">从思考到实践</p>
<h2>判断需要回到实践中检验。</h2>
<p>研究记录与实践复盘互相连接；涉及公司信息时，明确区分个人分析与官方资料。</p>
</div>
<a class="text-link" href="/practice/">阅读实践与方法 →</a>
</section>
</Base>
