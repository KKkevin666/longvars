---
import '../styles/global.css';
import { site, absolute, production } from '../../site.config.mjs';
interface Props { title: string; description: string; canonical?: string; article?: boolean; published?: string; updated?: string; noindex?: boolean; structured?: Record<string, unknown>; }
const { title, description, canonical = absolute(Astro.url.pathname), article = false, published, updated, noindex = false, structured } = Astro.props;
const nav = [['/topics/','长期主题'],['/notes/','短观点'],['/research/','研究文章'],['/practice/','实践复盘'],['/about/','关于我']];
const person = site.author ? { '@context':'https://schema.org', '@type':'Person', '@id':absolute('/about/#person'), name:site.author, url:absolute('/about/'), ...(site.company ? { worksFor: { '@type':'Organization', name:site.company.name, url:site.company.url }, jobTitle:site.company.role } : {}) } : null;
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title === site.title ? title : `${title} · ${site.title}`}</title>
<meta name="description" content={description}/>
<meta name="robots" content={!production || noindex ? 'noindex, nofollow' : 'index, follow'}/>
<link rel="canonical" href={canonical}/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={absolute('/rss.xml')}/>
<meta property="og:type" content={article ? 'article' : 'website'}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:site_name" content={site.title}/>
<meta property="og:locale" content="zh_CN"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
{published && <meta property="article:published_time" content={`${published}T00:00:00+08:00`}/>}{updated && <meta property="article:modified_time" content={`${updated}T00:00:00+08:00`}/>}
{person && <script is:inline type="application/ld+json" set:html={json(person)}/>}{structured && <script is:inline type="application/ld+json" set:html={json(structured)}/>}
</head>
<body>
<a class="skip" href="#main">跳至正文</a>
<div class="shell">
<header class="site-header">
<a class="identity" href="/">{site.title}<span>AI · 企业经营 · 资本</span>
</a>
<nav aria-label="主导航">{nav.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
</header>
{!production && <div class="preview-note">预览版本 · 示例内容仅用于验证网站，尚未开放搜索索引。</div>}
<main id="main">
<slot/>
</main>
<footer class="site-footer">
<div>
<strong>{site.author || site.title}</strong>
<p>个人研究与观点，不代表任何公司的官方立场。</p>
</div>
<div class="footer-links">
<a href="/archive/">全部归档</a>
<a href="/rss.xml">RSS</a>
<a href="/about/#contact">联系</a>
</div>
<p class="footer-small">长期写作，持续修订。引用请附原文链接与访问日期。</p>
</footer>
</div>
</body>
</html>
